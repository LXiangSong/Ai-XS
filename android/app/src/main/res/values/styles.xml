<resources>

    <!-- ============ Theme ============ -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/xs_primary</item>
        <item name="colorOnPrimary">@color/xs_on_primary</item>
        <item name="colorPrimaryContainer">@color/xs_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/xs_on_primary_container</item>
        <item name="colorPrimaryInverse">@color/xs_primary_container</item>

        <item name="colorSecondary">@color/xs_secondary</item>
        <item name="colorOnSecondary">@color/xs_on_secondary</item>
        <item name="colorSecondaryContainer">@color/xs_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/xs_on_secondary_container</item>

        <item name="colorTertiary">@color/xs_secondary</item>
        <item name="colorOnTertiary">@color/xs_on_secondary</item>
        <item name="colorTertiaryContainer">@color/xs_secondary_container</item>
        <item name="colorOnTertiaryContainer">@color/xs_on_secondary_container</item>

        <item name="colorError">@color/xs_error</item>
        <item name="colorOnError">@color/xs_on_error</item>
        <item name="colorErrorContainer">@color/xs_error_container</item>
        <item name="colorOnErrorContainer">@color/xs_on_error_container</item>

        <item name="android:colorBackground">@color/xs_bg</item>
        <item name="android:windowBackground">@color/xs_bg</item>
        <item name="colorControlHighlight">@color/xs_press</item>
        <item name="android:colorControlHighlight">@color/xs_press</item>
        <item name="colorControlActivated">@color/xs_primary</item>
        <item name="colorSurface">@color/xs_surface</item>
        <item name="colorOnSurface">@color/xs_on_surface</item>
        <item name="colorSurfaceVariant">@color/xs_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/xs_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/xs_surface_container_low</item>
        <item name="colorSurfaceContainerLow">@color/xs_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/xs_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/xs_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/xs_surface_container_highest</item>
        <item name="colorSurfaceInverse">@color/xs_surface_container_high</item>
        <item name="colorOnSurfaceInverse">@color/xs_on_surface</item>
        <item name="colorOutline">@color/xs_outline</item>
        <item name="colorOutlineVariant">@color/xs_outline_variant</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowAnimationStyle">@style/Animation.Xs.Window</item>

        <item name="materialButtonStyle">@style/Xs.Button.Primary</item>
        <item name="materialCardViewStyle">@style/Xs.Card</item>
        <item name="textInputStyle">@style/Xs.Field</item>
        <item name="materialAlertDialogTheme">@style/Xs.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/Xs.BottomSheet</item>
    </style>

    <style name="Animation.Xs.Window" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@android:anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@android:anim/fade_out</item>
    </style>

    <!-- ============ Shape ============ -->
    <style name="ShapeAppearance.Xs.Card" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">20dp</item>
    </style>
    <style name="ShapeAppearance.Xs.Small" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">14dp</item>
    </style>
    <style name="ShapeAppearance.Xs.Sheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    <style name="ShapeAppearance.Xs.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- ============ Type ============ -->
    <style name="Text.Xs.Display" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">26sp</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>
    <style name="Text.Xs.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>
    <style name="Text.Xs.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>
    <style name="Text.Xs.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">5dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="Text.Xs.Meta" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="Text.Xs.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- ============ Widgets ============ -->
    <style name="Xs.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/xs_surface_container</item>
        <item name="strokeColor">@color/xs_outline_variant</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Xs.Card</item>
        <item name="rippleColor">?attr/colorOutline</item>
    </style>

    <style name="Xs.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextAppearance">@style/Text.Xs.Title</item>
        <item name="subtitleTextAppearance">@style/Text.Xs.Meta</item>
        <item name="navigationIconTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Xs.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">44dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="iconSize">22dp</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Xs.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:layout_marginVertical">5dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Xs.Small</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="iconTint">?attr/colorOnPrimary</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
            <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">#33FFFFFF</item>
</style>

    <style name="Xs.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:layout_marginVertical">5dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
        <item name="cornerRadius">14dp</item>
            <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@color/xs_press</item>
</style>

    <style name="Xs.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
        <item name="cornerRadius">12dp</item>
            <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@color/xs_press</item>
</style>

    <style name="Xs.Field" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">?attr/colorPrimary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxBackgroundColor">@android:color/transparent</item>
        <item name="hintTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Xs.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="shapeAppearance">@style/ShapeAppearance.Xs.Pill</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Xs.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Xs.Card</item>
        <item name="colorSurfaceContainerHigh">@color/xs_surface_container_high</item>
        <item name="android:background">@color/xs_surface_container</item>
    </style>

    <style name="Xs.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Xs.BottomSheet.Style</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Xs.BottomSheet.Style" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/xs_surface_container</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Xs.Sheet</item>
        <item name="android:maxWidth">640dp</item>
    </style>

    <!-- Kept for call sites that add a read-only status line. -->
    <style name="Xs.StatusCard" parent="">
        <item name="android:background">@drawable/bg_status_card</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:layout_marginVertical">6dp</item>
    </style>
</resources>
